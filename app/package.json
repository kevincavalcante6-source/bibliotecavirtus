{
  "name": "biblioteca-virtus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test:webhook": "esbuild ../supabase/functions/cakto-webhook/handler.ts --format=esm --log-level=warning --outfile=../supabase/functions/cakto-webhook/handler.build.mjs && node --test ../supabase/functions/cakto-webhook/handler.test.mjs",
    "test:share": "esbuild src/lib/shareToPhotos.ts --format=esm --outfile=tests/.build/shareToPhotos.mjs --log-level=warning && node --test tests/shareToPhotos.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
