# Copie para .env.local e preencha com as chaves do seu projeto Supabase
# (Project Settings -> API). A anon key é pública por natureza: quem protege
# os dados é o RLS definido em supabase/migrations.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Endereço público do site, usado na prévia do link (WhatsApp, e-mail).
# Em desenvolvimento pode ficar vazio.
VITE_SITE_URL=
